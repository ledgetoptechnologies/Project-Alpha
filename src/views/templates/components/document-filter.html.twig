{#
  Reusable Document List Filter Component (Twig)
  
  Parameters:
  - page: The current page (used for form action)
  - filters: Array of filter configurations, each with:
    - type: 'text', 'date', 'select', 'number', 'client_autocomplete'
    - label: Display label
    - name: Form input name
    - value: Current value
    - id_value: For client_autocomplete, the client ID value
  - options: For select type, array of [{value: '', label: 'All'}, ...]
  - placeholder: Optional placeholder text
  - step: For number inputs, the step value
  - primary_count: Optional number of filters shown in the primary row (defaults to 4)
#}

{% macro field(filterName, config, instanceId, compact) %}
    {% set type = config.type|default('text') %}
    {% set label = config.label|default(filterName|capitalize) %}
    {% set value = config.value|default('') %}
    {% set idValue = config.id_value|default(0) %}
    {% set width = config.width|default(type == 'client_autocomplete' ? '240px' : (type == 'date' ? '150px' : (type == 'number' ? '130px' : '170px'))) %}
    {% set fieldStyle = 'display:flex;flex-direction:column;gap:6px;' ~ (compact ? 'flex:0 1 ' ~ width ~ ';min-width:min(' ~ width ~ ',100%);' : '') ~ (type == 'client_autocomplete' ? 'position:relative;' : '') %}

    <div style="{{ fieldStyle }}">
        <label for="{{ instanceId }}_{{ filterName }}" style="font-size:13px;font-weight:600;color:#374151">
            {{ label }}
        </label>

        {% if type == 'text' %}
            <input
                type="text"
                id="{{ instanceId }}_{{ filterName }}"
                name="{{ filterName }}"
                value="{{ value }}"
                placeholder="{{ config.placeholder|default('') }}"
                style="padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;width:100%"
            >

        {% elseif type == 'date' %}
            <input
                type="date"
                id="{{ instanceId }}_{{ filterName }}"
                name="{{ filterName }}"
                value="{{ value }}"
                style="padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;width:100%"
            >

        {% elseif type == 'number' %}
            <input
                type="number"
                id="{{ instanceId }}_{{ filterName }}"
                name="{{ filterName }}"
                value="{{ value }}"
                placeholder="{{ config.placeholder|default('') }}"
                step="{{ config.step|default('1') }}"
                style="padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;width:100%"
            >

        {% elseif type == 'select' %}
            <select
                id="{{ instanceId }}_{{ filterName }}"
                name="{{ filterName }}"
                style="padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;width:100%"
            >
                {% if config.options %}
                    {% for option in config.options %}
                        <option value="{{ option.value|default('') }}" {% if option.value|default('') == value %}selected{% endif %}>
                            {{ option.label }}
                        </option>
                    {% endfor %}
                {% endif %}
            </select>

        {% elseif type == 'client_autocomplete' %}
            <input
                type="hidden"
                id="{{ instanceId }}_{{ filterName }}_id"
                name="{{ filterName }}_id"
                value="{{ idValue }}"
            >
            <input
                type="text"
                id="{{ instanceId }}_{{ filterName }}"
                name="{{ filterName }}"
                value="{{ value }}"
                placeholder="{{ config.placeholder|default('Search client...') }}"
                style="padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;position:relative;z-index:1;width:100%"
                data-autocomplete="client"
                data-hidden-id="{{ instanceId }}_{{ filterName }}_id"
            >
            <div id="{{ instanceId }}_{{ filterName }}_suggestions" style="position:absolute;display:none;background:#fff;border:1px solid #ddd;border-radius:6px;max-height:200px;overflow-y:auto;width:100%;z-index:10;margin-top:-4px;top:100%"></div>
        {% endif %}
    </div>
{% endmacro %}

{% import _self as filterParts %}
{% set primaryCount = primary_count|default(4) %}
{% set instanceId = 'filter_' ~ (page|replace({'/' : '_'}))|slice(0, 8) %}
{% set advancedFilters = filters|slice(primaryCount) %}
{% set storageKey = 'document-filter:' ~ page %}

<form
    method="get"
    action="/"
    style="display:flex;flex-wrap:wrap;gap:12px 14px;align-items:flex-end;margin:16px 0 22px;position:relative"
    {% if live_filter_fields is defined and live_filter_fields|length > 0 %}
        data-live-filter-id="{{ live_filter_id|default(page) }}"
        data-live-filter-fields="{{ live_filter_fields|join(',') }}"
        data-live-filter-debounce="{{ live_filter_debounce|default(300) }}"
    {% endif %}
>
    <input type="hidden" name="page" value="{{ page }}">

    {% for filterName, config in filters %}
        {% if loop.index <= primaryCount %}
            {{ filterParts.field(filterName, config, instanceId, true) }}
        {% endif %}
    {% endfor %}

    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
        <button
            type="submit"
            style="padding:9px 16px;background:#2563eb;color:#fff;border:0;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px"
        >
            Filter
        </button>
        <a
            href="/?page={{ page }}"
            style="padding:9px 16px;background:#f3f4f6;color:#374151;border:1px solid #d1d5db;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px;text-decoration:none;text-align:center;display:inline-block"
        >
            Reset
        </a>
        {% if advancedFilters|length > 0 %}
            <button
                type="button"
                data-filter-toggle="{{ instanceId }}_advanced"
                data-filter-storage-key="{{ storageKey }}"
                aria-expanded="false"
                style="padding:9px 16px;background:#fff;color:#374151;border:1px solid #d1d5db;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px"
            >
                More filters
            </button>
        {% endif %}
    </div>

    {% if advancedFilters|length > 0 %}
        <div
            id="{{ instanceId }}_advanced"
            data-filter-panel
            data-filter-storage-key="{{ storageKey }}"
            style="display:none;flex-basis:100%;padding:12px 0 0;border-top:1px solid #eef0f2"
        >
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px 14px;align-items:end">
                {% for filterName, config in advancedFilters %}
                    {{ filterParts.field(filterName, config, instanceId, false) }}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if live_filter_fields is defined and live_filter_fields|length > 0 %}
        <div
            data-live-filter-status
            role="status"
            aria-live="polite"
            style="flex-basis:100%;min-height:18px;color:var(--muted);font-size:13px"
        >{{ live_filter_help|default('Results update automatically as you type.') }}</div>
    {% endif %}
</form>

<script>
// Client autocomplete functionality
document.querySelectorAll('[data-autocomplete="client"]').forEach(input => {
    const hiddenId = input.getAttribute('data-hidden-id');
    const hiddenInput = document.getElementById(hiddenId);
    const suggestionsDiv = document.getElementById(input.id + '_suggestions');
    let selectedName = input.value.trim();
    
    // Fetch clients on input
    input.addEventListener('input', function() {
        const query = this.value.trim();
        if (hiddenInput && query !== selectedName) {
            hiddenInput.value = '';
        }
        if (query.length < 2) {
            suggestionsDiv.style.display = 'none';
            return;
        }
        
        fetch('/?page=clients-search&term=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(list => {
                if (!Array.isArray(list) || list.length === 0) {
                    suggestionsDiv.style.display = 'none';
                    return;
                }
                suggestionsDiv.replaceChildren();
                list.forEach(x => {
                    const el = document.createElement('div');
                    el.style.cssText = 'padding:8px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6';
                    el.textContent = String(x.name ?? '');
                    el.addEventListener('click', function() {
                        input.value = String(x.name ?? '');
                        selectedName = input.value.trim();
                        if (hiddenInput) {
                            hiddenInput.value = String(x.id ?? '');
                        }
                        suggestionsDiv.style.display = 'none';
                    });
                    suggestionsDiv.appendChild(el);
                });
                suggestionsDiv.style.display = 'block';
            })
            .catch(() => {
                suggestionsDiv.style.display = 'none';
            });
    });
    
    input.addEventListener('blur', function() {
        setTimeout(() => {
            suggestionsDiv.style.display = 'none';
        }, 200);
    });
});
</script>
