# Project Alpha cron jobs
# Environment variables are written to /etc/environment by entrypoint.sh
# so they are available to cron jobs via the shell wrapper below.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Unified log file for all cron jobs
CRON_LOG=/var/www/config/logs/cron/cron.log

# Times are interpreted in the PA system timezone applied by entrypoint.sh.

# Deliver optional external-operations entitlement events with safe retries.
* * * * * root . /etc/environment && php /var/www/src/cron/send_external_ops_outbox.php >> $CRON_LOG 2>&1

# Process the disabled-by-default internal notification relay queue.
* * * * * root . /etc/environment && php /var/www/src/cron/process_notification_relay.php >> $CRON_LOG 2>&1

# Workforce deadline reminders and automatic confirmation - every 5 minutes
*/5 * * * * root . /etc/environment && php /var/www/src/cron/process_workforce_deadlines.php >> $CRON_LOG 2>&1

# Rotate repository-owned system and cron logs at the 10 MiB threshold.
* * * * * www-data . /etc/environment && php /var/www/src/cron/rotate_logs.php >> $CRON_LOG 2>&1

# Generate recurring invoices - daily at 2:00 AM
0 2 * * * root . /etc/environment && php /var/www/src/cron/generate_recurring_invoices.php >> $CRON_LOG 2>&1

# Generate predictable recurring expenses - daily at 2:15 AM
15 2 * * * root . /etc/environment && php /var/www/src/cron/generate_recurring_expenses.php >> $CRON_LOG 2>&1

# Purge sensitive finalized GPS route points after 90 days - daily at 2:30 AM
30 2 * * * root . /etc/environment && php /var/www/src/cron/purge_mileage_tracking_points.php >> $CRON_LOG 2>&1

# Bound generic portal replay/rate security state (48-hour buckets, 24-hour receipts).
* * * * * root . /etc/environment && php /var/www/src/cron/prune_portal_integration_security.php >> $CRON_LOG 2>&1

# Deliver default-off, operator-configured portal projections in bounded batches.
* * * * * root . /etc/environment && php /var/www/src/cron/send_portal_projection_outbox.php >> $CRON_LOG 2>&1

# Provision historical portal roots after the unified producer is fully ready.
* * * * * root . /etc/environment && php /var/www/src/cron/reconcile_client_portal.php >> $CRON_LOG 2>&1

# Retry default-off, manually-created managed delivery and revocation intents.
* * * * * root . /etc/environment && php /var/www/src/cron/send_managed_delivery_intents.php >> $CRON_LOG 2>&1

# Check hourly at :30; the script honors the configured PA timezone backup hour.
30 * * * * root . /etc/environment && php /var/www/src/cron/backup_database.php --scheduled >> $CRON_LOG 2>&1

# Auto-terminate expired contracts - daily at 3:00 AM
0 3 * * * root . /etc/environment && php /var/www/src/cron/auto_terminate_contracts.php >> $CRON_LOG 2>&1

# Check and expire links - daily at 4:00 AM
0 4 * * * root . /etc/environment && php /var/www/src/cron/link_expiration_checker.php >> $CRON_LOG 2>&1

# Scan enabled link providers for organization, department, and standalone client folders - daily at 4:15 AM
15 4 * * * root . /etc/environment && php /var/www/src/cron/daily_link_resolver.php >> $CRON_LOG 2>&1

# Process audit schedules - daily at 6:00 AM
0 6 * * * root . /etc/environment && php /var/www/src/cron/process_audit_schedules.php >> $CRON_LOG 2>&1

# Send invoice reminders (due-7 and overdue-weekly) - daily at 8:00 AM
0 8 * * * root . /etc/environment && php /var/www/src/cron/send_invoice_reminders.php >> $CRON_LOG 2>&1

# Stripe payment reconciliation - every 6 hours
0 */6 * * * root . /etc/environment && php /var/www/src/cron/stripe_reconciliation.php >> $CRON_LOG 2>&1

# Sync actual Stripe merchant rate (non-changeable) - daily at 5:00 AM
0 5 * * * root . /etc/environment && php /var/www/src/cron/sync_merchant_rate.php >> $CRON_LOG 2>&1

# Required blank line at end of crontab
