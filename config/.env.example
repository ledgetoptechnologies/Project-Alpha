# Optional environment-variable reference for custom deployments. The standard
# Docker Compose installation does not require copying this file or creating a
# host .env file. Never commit real credentials or encryption keys.

APP_ENV=production
APP_HOST=https://project-alpha.example.com
# Exact browser origin used for passkeys. Keep the scheme and omit paths.
WEBAUTHN_ORIGIN=https://project-alpha.example.com
# Optional; defaults to the WEBAUTHN_ORIGIN hostname.
WEBAUTHN_RP_ID=project-alpha.example.com

DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=project_alpha
MYSQL_USER=project_alpha
MYSQL_PASSWORD=change-me-use-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-use-a-different-long-random-password

# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Configure real payment secrets in Settings > Billing when possible.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Internal notification relay. Keep disabled until the private ingress, policy,
# dedicated IP-restricted API key, existing mail provider, and cron worker are ready.
NOTIFICATION_RELAY_ENABLED=false
NOTIFICATION_RELAY_CONFIG_PATH=/var/www/config/notification-relay.json

# Sync Contract v2 foundation. Keep disabled until mutation adapters, tenant
# isolation, reconciliation delivery, and the documented production gate pass.
APP_SYNC_CONTRACT_V2_ENABLED=false

# Generic API v2 organization profile command. This endpoint is deliberately
# disabled by default and returns 404 until a deployment has completed the
# documented backfill, writer, MySQL-concurrency, and handoff release gates.
APP_API_V2_DIRECTORY_ORGANIZATIONS_WRITE_ENABLED=false

# Generic API v2 client profile command. This endpoint is deliberately
# disabled by default and returns 404 until its documented release gates pass.
APP_API_V2_DIRECTORY_CLIENTS_WRITE_ENABLED=false
APP_API_V2_DIRECTORY_CLIENTS_CREATE_ENABLED=false
APP_API_V2_DIRECTORY_ORGANIZATIONS_CREATE_ENABLED=false

# Optional generic inbound portal adapter. Keep both gates false and the secret
# map empty until a separately approved inbound profile has passed preflight.
APP_PORTAL_PRICING_PREVIEW_ENABLED=false
APP_PORTAL_DRAFT_QUOTES_ENABLED=false
PORTAL_INTEGRATION_HMAC_SECRETS_JSON={}
