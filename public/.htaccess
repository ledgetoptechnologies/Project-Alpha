# Pass Authorization header to PHP (needed for Bearer token API auth)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # External Operations snapshot API. Route the clean public path through
    # PA's front controller while preserving its public pagination query.
    RewriteRule ^api/v1/ops/snapshot/?$ index.php [QSA,L]
    RewriteRule ^api/v2/ops/snapshot/?$ index.php [QSA,L]

    # Reviewed external project-management links use this query-free entry
    # point. The front controller forces the existing project-list route and
    # rejects non-read methods; query parameters remain available only for the
    # established list filters.
    RewriteRule ^projects/?$ index.php [QSA,L]

    # Container readiness must enter PA's front controller so schema health is
    # checked before Apache reports the application as available.
    RewriteRule ^health/ready/?$ index.php?page=health/ready [QSA,L]

    # Built-in Workforce module clean paths. Keep these explicit so unknown
    # paths still receive Apache's normal 404 instead of entering PA's router.
    RewriteRule ^time/?$ index.php?page=workforce/time [QSA,L]
    RewriteRule ^time/action/?$ index.php?page=workforce/action [QSA,L]
    RewriteRule ^workforce/?$ index.php?page=workforce/overview [QSA,L]
    RewriteRule ^workforce/action/?$ index.php?page=workforce/action [QSA,L]
    RewriteRule ^approvals/?$ index.php?page=workforce/approvals [QSA,L]
    RewriteRule ^approvals/action/?$ index.php?page=workforce/action [QSA,L]
    RewriteRule ^pay/?$ index.php?page=workforce/pay [QSA,L]
    RewriteRule ^pay/action/?$ index.php?page=workforce/action [QSA,L]

    # Stripe webhook endpoints. Stripe cannot send query-string routes reliably
    # when the endpoint is configured as a clean path, so map both public paths
    # to the existing front-controller routes.
    RewriteRule ^stripe-webhook/?$ index.php?page=stripe-webhook [QSA,L]
    RewriteRule ^stripe-webhook-legacy/?$ index.php?page=stripe-webhook-legacy [QSA,L]

</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Enable compression for text files
<IfModule mod_deflate.c>
    <FilesMatch "\.(css|js|html|php)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - cache for 1 month
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/ico "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    
    # CSS and JS - cache for 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    
    # Fonts - cache for 1 month
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
</IfModule>

# Alternative cache headers for servers without mod_expires
<IfModule mod_headers.c>
    # Cache images for 1 month
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Cache CSS and JS for 1 week
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    
    # Prevent caching of PHP files
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Security headers (keeping your existing ones)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
